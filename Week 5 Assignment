<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JavaScript Fundamentals</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1a2a6c, #b21f1f, #fdbb2d);
            color: #333;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 2px solid #eee;
        }

        h1 {
            color: #1a2a6c;
            font-size: 2.8rem;
            margin-bottom: 10px;
        }

        h2 {
            color: #b21f1f;
            margin: 25px 0 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        h3 {
            color: #fdbb2d;
            margin: 20px 0 10px;
        }

        p {
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .section {
            background: white;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .code-example {
            background-color: #2d3748;
            color: #e2e8f0;
            padding: 15px;
            border-radius: 8px;
            margin: 15px 0;
            overflow-x: auto;
            font-family: 'Courier New', monospace;
        }

        .btn {
            background: #4a5568;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            margin: 10px 5px;
            transition: background 0.3s;
        }

        .btn:hover {
            background: #2d3748;
        }

        .btn-primary {
            background: #1a2a6c;
        }

        .btn-primary:hover {
            background: #0e1a4a;
        }

        .btn-success {
            background: #2d7d1f;
        }

        .btn-success:hover {
            background: #1f5a14;
        }

        input, select {
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            margin: 10px 5px;
            width: 200px;
        }

        .output {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin: 15px 0;
            min-height: 50px;
            border-left: 4px solid #1a2a6c;
        }

        .flex-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin: 20px 0;
        }

        .card {
            flex: 1;
            min-width: 250px;
            background: #f1f5f9;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        }

        .user-list {
            list-style-type: none;
        }

        .user-list li {
            padding: 10px;
            margin: 8px 0;
            background: #e2e8f0;
            border-radius: 6px;
            transition: transform 0.2s;
        }

        .user-list li:hover {
            transform: translateX(5px);
            background: #cbd5e0;
        }

        .highlight {
            background-color: #ffeb3b;
            padding: 2px 5px;
            border-radius: 3px;
        }

        footer {
            text-align: center;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 2px solid #eee;
            color: #6c757d;
        }

        @media (max-width: 768px) {
            .flex-container {
                flex-direction: column;
            }
            
            input, select {
                width: 100%;
                margin: 5px 0;
            }
            
            .btn {
                width: 100%;
                margin: 5px 0;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>JavaScript Fundamentals</h1>
            <p>Mastering Functions, Loops, and DOM Manipulation</p>
        </header>

        <!-- Part 1: JavaScript Basics -->
        <section class="section">
            <h2>Part 1: JavaScript Basics</h2>
            <p>Variables, data types, operators, and conditionals</p>
            
            <div class="code-example">
                // Example: Conditional logic<br>
                let temperature = 28;<br>
                let weather = temperature > 25 ? "hot" : "pleasant";<br>
                console.log(`It's ${weather} outside.`);
            </div>
            
            <h3>Try it yourself:</h3>
            <input type="number" id="userAge" placeholder="Enter your age">
            <button class="btn btn-primary" onclick="checkAge()">Check Age</button>
            <div class="output" id="ageOutput">Result will appear here...</div>
        </section>

        <!-- Part 2: JavaScript Functions -->
        <section class="section">
            <h2>Part 2: JavaScript Functions</h2>
            <p>Reusable blocks of code that perform specific tasks</p>
            
            <div class="code-example">
                // Function to calculate area of a rectangle<br>
                function calculateArea(width, height) {<br>
                &nbsp;&nbsp;return width * height;<br>
                }<br>
                console.log(calculateArea(5, 8)); // Output: 40
            </div>
            
            <h3>Function Examples:</h3>
            <div class="flex-container">
                <div class="card">
                    <h4>String Formatter</h4>
                    <input type="text" id="formatInput" placeholder="Enter text" value="hello world">
                    <button class="btn" onclick="formatText()">Format Text</button>
                    <div class="output" id="formatOutput">Formatted text will appear here...</div>
                </div>
                
                <div class="card">
                    <h4>Cost Calculator</h4>
                    <input type="number" id="priceInput" placeholder="Price" value="100">
                    <input type="number" id="quantityInput" placeholder="Quantity" value="2">
                    <button class="btn" onclick="calculateTotal()">Calculate Total</button>
                    <div class="output" id="calculateOutput">Total will appear here...</div>
                </div>
            </div>
        </section>

        <!-- Part 3: JavaScript Loops -->
        <section class="section">
            <h2>Part 3: JavaScript Loops</h2>
            <p>Execute code repeatedly until a condition is met</p>
            
            <div class="code-example">
                // Loop through an array<br>
                const fruits = ["apple", "banana", "orange"];<br>
                for (let i = 0; i < fruits.length; i++) {<br>
                &nbsp;&nbsp;console.log(fruits[i]);<br>
                }
            </div>
            
            <h3>Loop Examples:</h3>
            <div class="flex-container">
                <div class="card">
                    <h4>Countdown</h4>
                    <input type="number" id="countdownInput" placeholder="Enter number" value="5">
                    <button class="btn" onclick="startCountdown()">Start Countdown</button>
                    <div class="output" id="countdownOutput">Countdown will appear here...</div>
                </div>
                
                <div class="card">
                    <h4>Number Sequence</h4>
                    <input type="number" id="sequenceInput" placeholder="Enter number" value="10">
                    <button class="btn" onclick="generateSequence()">Generate Sequence</button>
                    <div class="output" id="sequenceOutput">Sequence will appear here...</div>
                </div>
            </div>
        </section>

        <!-- Part 4: DOM Manipulation -->
        <section class="section">
            <h2>Part 4: DOM Manipulation</h2>
            <p>Interact with and modify the Document Object Model</p>
            
            <div class="code-example">
                // Change text content of an element<br>
                document.getElementById("myElement").textContent = "New content!";<br><br>
                
                // Add event listener<br>
                document.getElementById("myButton").addEventListener("click", function() {<br>
                &nbsp;&nbsp;alert("Button clicked!");<br>
                });
            </div>
            
            <h3>DOM Interaction Examples:</h3>
            <div class="flex-container">
                <div class="card">
                    <h4>Add List Items</h4>
                    <input type="text" id="newItemInput" placeholder="Enter item name">
                    <button class="btn btn-success" onclick="addItem()">Add Item</button>
                    <ul class="user-list" id="itemList">
                        <li>Sample Item 1</li>
                        <li>Sample Item 2</li>
                    </ul>
                </div>
                
                <div class="card">
                    <h4>Theme Switcher</h4>
                    <button class="btn" onclick="switchTheme('light')">Light Theme</button>
                    <button class="btn" onclick="switchTheme('dark')">Dark Theme</button>
                    <button class="btn" onclick="switchTheme('colorful')">Colorful Theme</button>
                </div>
                
                <div class="card">
                    <h4>Element Styler</h4>
                    <select id="elementSelector">
                        <option value="header">Header</option>
                        <option value="section">Sections</option>
                        <option value="card">Cards</option>
                    </select>
                    <select id="styleSelector">
                        <option value="highlight">Highlight</option>
                        <option value="border">Add Border</option>
                        <option value="shadow">Add Shadow</option>
                    </select>
                    <button class="btn" onclick="applyStyle()">Apply Style</button>
                </div>
            </div>
        </section>

        <footer>
            <p>JavaScript Fundamentals Assignment &copy; 2023</p>
        </footer>
    </div>

    <script>
        // Part 1: JavaScript Basics
        function checkAge() {
            const ageInput = document.getElementById('userAge');
            const outputElement = document.getElementById('ageOutput');
            
            const age = parseInt(ageInput.value);
            
            if (isNaN(age)) {
                outputElement.textContent = 'Please enter a valid number.';
                outputElement.style.color = 'red';
                return;
            }
            
            let message;
            if (age < 0) {
                message = "Age cannot be negative!";
            } else if (age < 13) {
                message = "You are a child.";
            } else if (age < 20) {
                message = "You are a teenager.";
            } else if (age < 65) {
                message = "You are an adult.";
            } else {
                message = "You are a senior.";
            }
            
            outputElement.textContent = message;
            outputElement.style.color = 'green';
        }

        // Part 2: JavaScript Functions
        function formatText() {
            const inputText = document.getElementById('formatInput').value;
            const outputElement = document.getElementById('formatOutput');
            
            // Format the text: capitalize first letter of each word
            const formattedText = inputText
                .split(' ')
                .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                .join(' ');
                
            outputElement.textContent = formattedText;
        }

        function calculateTotal() {
            const price = parseFloat(document.getElementById('priceInput').value);
            const quantity = parseInt(document.getElementById('quantityInput').value);
            const outputElement = document.getElementById('calculateOutput');
            
            if (isNaN(price) || isNaN(quantity)) {
                outputElement.textContent = 'Please enter valid numbers.';
                outputElement.style.color = 'red';
                return;
            }
            
            const total = price * quantity;
            outputElement.textContent = `Total: $${total.toFixed(2)}`;
            outputElement.style.color = 'green';
        }

        // Part 3: JavaScript Loops
        function startCountdown() {
            const number = parseInt(document.getElementById('countdownInput').value);
            const outputElement = document.getElementById('countdownOutput');
            
            if (isNaN(number) || number < 1) {
                outputElement.textContent = 'Please enter a positive number.';
                outputElement.style.color = 'red';
                return;
            }
            
            outputElement.innerHTML = ''; // Clear previous content
            
            // Using a for loop for countdown
            for (let i = number; i >= 0; i--) {
                const paragraph = document.createElement('p');
                paragraph.textContent = i === 0 ? 'Blast off! 🚀' : `Countdown: ${i}`;
                outputElement.appendChild(paragraph);
                
                // Add some color for visual interest
                if (i === 0) {
                    paragraph.style.color = 'green';
                    paragraph.style.fontWeight = 'bold';
                } else if (i <= 3) {
                    paragraph.style.color = 'red';
                }
            }
        }

        function generateSequence() {
            const number = parseInt(document.getElementById('sequenceInput').value);
            const outputElement = document.getElementById('sequenceOutput');
            
            if (isNaN(number) || number < 1) {
                outputElement.textContent = 'Please enter a positive number.';
                outputElement.style.color = 'red';
                return;
            }
            
            let sequence = [];
            
            // Using a while loop to generate sequence
            let i = 0;
            while (i <= number) {
                sequence.push(i);
                i++;
            }
            
            outputElement.textContent = sequence.join(', ');
        }

        // Part 4: DOM Manipulation
        function addItem() {
            const itemInput = document.getElementById('newItemInput');
            const itemList = document.getElementById('itemList');
            
            if (itemInput.value.trim() === '') {
                alert('Please enter an item name.');
                return;
            }
            
            // Create new list item
            const newItem = document.createElement('li');
            newItem.textContent = itemInput.value;
            
            // Add delete functionality
            newItem.onclick = function() {
                this.remove();
            };
            
            itemList.appendChild(newItem);
            itemInput.value = ''; // Clear input
        }

        function switchTheme(theme) {
            const container = document.querySelector('.container');
            
            // Remove existing theme classes
            container.classList.remove('light-theme', 'dark-theme', 'colorful-theme');
            
            // Apply selected theme
            if (theme === 'light') {
                container.style.backgroundColor = 'rgba(255, 255, 255, 0.95)';
                container.style.color = '#333';
            } else if (theme === 'dark') {
                container.style.backgroundColor = 'rgba(40, 40, 40, 0.95)';
                container.style.color = '#fff';
            } else if (theme === 'colorful') {
                container.style.backgroundColor = 'rgba(255, 240, 245, 0.95)';
                container.style.color = '#333';
            }
        }

        function applyStyle() {
            const elementType = document.getElementById('elementSelector').value;
            const styleType = document.getElementById('styleSelector').value;
            
            const elements = document.querySelectorAll(elementType);
            
            // Remove previous styles
            elements.forEach(el => {
                el.classList.remove('highlight', 'border', 'shadow');
            });
            
            // Apply new style
            if (styleType === 'highlight') {
                elements.forEach(el => {
                    el.classList.add('highlight');
                });
            } else if (styleType === 'border') {
                elements.forEach(el => {
                    el.classList.add('border');
                    el.style.border = '2px solid #1a2a6c';
                });
            } else if (styleType === 'shadow') {
                elements.forEach(el => {
                    el.classList.add('shadow');
                    el.style.boxShadow = '0 4px 8px rgba(0, 0, 0, 0.2)';
                });
            }
        }

        // Initialize with some examples
        document.addEventListener('DOMContentLoaded', function() {
            // Set initial values for demonstration
            formatText();
            calculateTotal();
        });
    </script>
</body>
</html>
